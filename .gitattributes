# Normalise text files to LF in the repo
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png   binary
*.ico   binary
*.icns  binary
*.bmp   binary
*.woff2 binary

# Keep generated lockfiles out of diffs and language stats
package-lock.json  linguist-generated -diff
src-tauri/Cargo.lock linguist-generated -diff
